<script>
// Global search functionality (the topbar shows the search box to anonymous sessions too when search is public)
(function() {
    var searchWrap = document.getElementById('globalSearch');
    var searchInput = document.getElementById('globalSearchInput');
    var searchToggle = document.getElementById('globalSearchToggle');
    var searchClose = document.getElementById('globalSearchClose');
    var searchResults = document.getElementById('globalSearchResults');
    if (!searchInput || !searchResults) return;

    var timer = null;
    var selectedIndex = -1;
    var currentResults = [];

    var searchRoute = '<?php Functions::printRoute('search'); ?>';

    function closeDropdown() {
        searchResults.classList.remove('open');
        searchResults.innerHTML = '';
        selectedIndex = -1;
        currentResults = [];
    }

    function navigateTo(url) {
        closeDropdown();
        searchInput.value = '';
        window.location.href = url;
    }

    function renderDropdown(results) {
        searchResults.innerHTML = '';
        if (results.length === 0) {
            searchResults.innerHTML = '<div class="fw-search-result-item fw-search-result-empty"><?php Functions::printl('search_no_results'); ?></div>';
            searchResults.classList.add('open');
            return;
        }

        currentResults = results;
        results.forEach(function(item, i) {
            var div = document.createElement('a');
            div.className = 'fw-search-result-item';
            div.href = item.url;
            div.setAttribute('data-index', i);

            var iconMap = {
                ENTITY: 'bi-person',
                EVIDENCE: 'bi-file-earmark-text',
                REPORT: 'bi-flag',
                BLACKLIST: 'bi-shield-exclamation',
                OPERATOR: 'bi-person-badge',
                AUDIT_LOG: 'bi-journal-text',
                ATTACHMENT: 'bi-paperclip'
            };
            var badgeMap = {
                ENTITY: 'fw-search-badge-entity',
                EVIDENCE: 'fw-search-badge-evidence',
                REPORT: 'fw-search-badge-report',
                BLACKLIST: 'fw-search-badge-blacklist',
                OPERATOR: 'fw-search-badge-operator',
                AUDIT_LOG: 'fw-search-badge-audit-log',
                ATTACHMENT: 'fw-search-badge-audit-log'
            };

            var icon = iconMap[item.type] || 'bi-search';
            var badge = badgeMap[item.type] || '';

            div.innerHTML = '<i class="bi ' + icon + '"></i>' +
                '<div class="fw-search-result-info">' +
                    '<div class="fw-search-result-title">' + escapeHtml(item.title) + '</div>' +
                    '<div class="fw-search-result-desc">' + escapeHtml(item.desc || '') + '</div>' +
                '</div>' +
                '<span class="fw-badge fw-badge-sm ' + badge + '">' + escapeHtml(item.label) + '</span>';

            div.addEventListener('click', function(e) {
                e.preventDefault();
                navigateTo(this.href);
            });

            div.addEventListener('mouseenter', function() {
                searchResults.querySelectorAll('.fw-search-result-item').forEach(function(el) { el.classList.remove('active'); });
                div.classList.add('active');
                selectedIndex = i;
            });

            searchResults.appendChild(div);
        });

        // View all results link
        var query = searchInput.value.trim();
        if (query.length >= 2) {
            var viewAll = document.createElement('a');
            viewAll.className = 'fw-search-result-item fw-search-result-view-all';
            viewAll.href = searchRoute + '?q=' + encodeURIComponent(query);
            viewAll.innerHTML = '<?php Functions::printl('search_view_all'); ?> <i class="bi bi-arrow-right"></i>';
            viewAll.addEventListener('click', function(e) {
                e.preventDefault();
                navigateTo(this.href);
            });
            searchResults.appendChild(viewAll);
        }

        searchResults.classList.add('open');
        selectedIndex = -1;
    }

    function doSearch(query) {
        if (query.length < 2) { closeDropdown(); return; }
        searchResults.innerHTML = '<div class="fw-search-result-item fw-search-result-empty fw-search-result-item--searching"><?php Functions::printl('searching'); ?></div>';
        searchResults.classList.add('open');

        var xhr = new XMLHttpRequest();
        xhr.open('POST', searchRoute, true);
        xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
        xhr.onload = function() {
            if (xhr.status === 200) {
                try {
                    var resp = JSON.parse(xhr.responseText);
                    renderDropdown(resp.results || []);
                } catch(e) { closeDropdown(); }
            } else { closeDropdown(); }
        };
        xhr.onerror = function() { closeDropdown(); };
        xhr.send('action=search_dropdown&q=' + encodeURIComponent(query));
    }

    searchInput.addEventListener('input', function() {
        clearTimeout(timer);
        var val = this.value.trim();
        if (val.length >= 2) {
            timer = setTimeout(function() { doSearch(val); }, 250);
        } else { closeDropdown(); }
    });

    searchInput.addEventListener('keydown', function(e) {
        var items = searchResults.querySelectorAll('.fw-search-result-item:not(.fw-search-result-empty):not(.fw-search-result-view-all)');

        if (e.key === 'Enter') {
            e.preventDefault();
            var active = searchResults.querySelector('.fw-search-result-item.active');
            if (active && active.href) {
                navigateTo(active.href);
            } else {
                var query = this.value.trim();
                if (query.length >= 2) {
                    navigateTo(searchRoute + '?q=' + encodeURIComponent(query));
                }
            }
        } else if (e.key === 'ArrowDown') {
            e.preventDefault();
            selectedIndex = Math.min(selectedIndex + 1, items.length - 1);
            updateActive(items);
        } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            selectedIndex = Math.max(selectedIndex - 1, -1);
            updateActive(items);
        } else if (e.key === 'Escape') {
            closeDropdown();
            searchInput.blur();
        }
    });

    function updateActive(items) {
        items.forEach(function(el, i) {
            el.classList.toggle('active', i === selectedIndex);
        });
    }

    searchInput.addEventListener('focus', function() {
        var val = this.value.trim();
        if (val.length >= 2 && searchResults.children.length > 0) {
            searchResults.classList.add('open');
        }
    });

    // Dismisses the full-width field used on small screens (the class has no effect on wider ones).
    function closeMobileSearch() {
        searchInput.classList.remove('open');
        searchInput.blur();
        closeDropdown();
    }

    document.addEventListener('click', function(e) {
        if (!e.target.closest('#globalSearch')) closeDropdown();
    });

    // A tap outside the open full-width field only dismisses it; swallowing the tap (capture phase)
    // keeps it from also opening whatever link or table row was underneath.
    document.addEventListener('click', function(e) {
        if (searchInput.classList.contains('open') && !e.target.closest('#globalSearch')) {
            e.preventDefault();
            e.stopPropagation();
            closeMobileSearch();
        }
    }, true);

    if (searchClose) {
        searchClose.addEventListener('click', function(e) {
            e.stopPropagation();
            searchInput.value = '';
            closeMobileSearch();
        });
    }

    // Mobile toggle
    if (searchToggle) {
        searchToggle.addEventListener('click', function(e) {
            e.stopPropagation();
            searchInput.classList.toggle('open');
            if (searchInput.classList.contains('open')) {
                searchInput.focus();
            }
        });
    }

    // Close mobile search on Escape
    searchInput.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && searchInput.classList.contains('open')) {
            closeMobileSearch();
        }
    });
})();
</script>
