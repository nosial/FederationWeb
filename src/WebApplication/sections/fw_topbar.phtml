    $canViewSpecification = ViewAuthorization::supportsSpecification();

    if (!$isAnonymous && empty($operatorUuid) && $federationClient !== null)
    {
        try
        {
            $self = $federationClient->getSelf();
            $operatorName = $self->getName();
            $operatorUuid = $self->getUuid();
        }
        catch (Exception $e) {}
    }

    $assignedReportsCount = 0;
    if(!empty($operatorUuid) && $federationClient !== null)
    {
