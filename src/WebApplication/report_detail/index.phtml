<?php
    use DynamicalWeb\Enums\RequestMethod;
    use DynamicalWeb\Html\Functions;
    use DynamicalWeb\WebSession;
    use WebKernel\ReportDetailView;
    use WebKernel\ViewAuthorization;

    Functions::loadLocalization('reports');

    $reportDetailView = new ReportDetailView();
    WebSession::set('report_detail_view', $reportDetailView);

    if (WebSession::getRequest()->getMethod() === RequestMethod::POST && $reportDetailView->getReport())
    {
        $reportDetailView->handlePostRequest();
    }
?>
<!DOCTYPE html>
<html lang="<?php Functions::print(WebSession::getLocale()?->getLocaleCode() ?? 'en'); ?>" data-fw-theme="<?php Functions::print($reportDetailView->isDarkMode() ? 'dark' : ''); ?>">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
        <?php Functions::insertSection('../sections/head.phtml'); ?>
        <title><?php Functions::printl('record_title'); ?> — <?php Functions::print($reportDetailView->getReport() ? substr($reportDetailView->getReport()->getUuid(), 0, 8) . '…' : 'Error'); ?></title>
        <link rel="stylesheet" href="/vendor/bootstrap-icons/bootstrap-icons.min.css">
        <link rel="stylesheet" href="/css/federation.css">
    </head>
    <body class="fw-page--report">
        <div class="fw-wrapper">
            <?php Functions::insertSection('../sections/fw_topbar.phtml'); ?>
            <?php Functions::insertSection('../sections/fw_topnav.phtml'); ?>
            <div class="fw-main">
                <div class="fw-content">
                    <?php
                        if ($reportDetailView->hasError() || !$reportDetailView->getReport())
                        {
                            ?>
                            <div class="fw-error">
                                <div class="fw-error-card">
                                    <div class="fw-error-icon fw-error-icon-red">
                                        <i class="bi bi-exclamation-circle"></i>
                                    </div>
                                    <p class="fw-error-description"><?php Functions::printl('error_loading_entry'); ?></p>
                                    <div class="fw-error-actions">
                                        <a href="<?php Functions::printRoute('reports'); ?>" class="fw-btn fw-btn-primary">
                                            <i class="bi bi-arrow-left"></i> <?php Functions::printl('back'); ?>
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <?php
                        }
                        else
                        {
                            if ($reportDetailView->getSuccessMessage())
                            {
                                ?>
                                <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-check-circle-fill"></i>
                                        <span><?php Functions::printl($reportDetailView->getSuccessMessage()); ?></span>
                                    </div>
                                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                                </div>
                                <?php
                            }
                            if ($reportDetailView->getErrorMessage())
                            {
                                ?>
                                <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-exclamation-triangle-fill"></i>
                                        <div>
                                            <strong><?php Functions::printl($reportDetailView->getErrorMessage()); ?></strong>
                                            <?php
                                                if ($reportDetailView->getErrorDetail())
                                                {
                                                    ?><br><span class="fw-error-detail"><?php Functions::print($reportDetailView->getErrorDetail()); ?></span><?php
                                                }
                                            ?>
                                        </div>
                                    </div>
                                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                                </div>
                                <?php
                            }
                            ?>
                            <?php
                            Functions::insertSection('detail.phtml');
                            Functions::insertSection('related.phtml');
                            Functions::insertSection('modals.phtml');
                        }
                    ?>
                </div>
            </div>
        </div>
        <script src="/vendor/bootstrap/bootstrap.bundle.min.js"></script>
