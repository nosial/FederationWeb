<?php

    use DynamicalWeb\WebSession;
    use FederationLib\FederationClient;
    use FederationLib\Objects\ServerInformation;
    use WebKernel\ViewAuthorization;
    use DynamicalWeb\Enums\RequestMethod;
    use DynamicalWeb\Enums\ResponseCode;

    // This script is skipped for WebSocket requests ("websocket: false" in project.yml): the WebSocket
    // bridge terminates at the local TCP proxy, so their session fingerprint never matches the browser's.
    // WebSocket handlers must not read, create, or modify HTTP cookie sessions.

    // Initialize the cookie session if it does not exist
    if(!WebSession::hasCookieSession('web_session'))
    {
        $cookieSession = WebSession::createCookieSession([
            'authenticated' => false,
            'api_key' => null,
        ], 'web_session');
    }
    else
    {
        // MEMCACHED_SESSION_SLIDING=1 (see the Dockerfile) renews the browser cookie whenever the session is
        // read, so the session timeout is an idle timeout rather than an hour after signing in.
        $cookieSession = WebSession::getCookieSession('web_session');
    }

    WebSession::set('cookie_session', $cookieSession);

    // Every state-changing request must echo the session's CSRF token, as the csrf_token form field
    // (sections/csrf_field.phtml) or the X-CSRF-Token header (added to XHR and fetch by sections/head.phtml).
    // A form is sent back to its page with an error, where an expired session leads to the login page as before.
    // DynamicalWeb's csrf_protection option is not used because it answers forms with a 403 page instead.
    $request = WebSession::getRequest();
    if (in_array($request->getMethod(), [RequestMethod::POST, RequestMethod::PUT, RequestMethod::DELETE], true) && !WebSession::verifyCsrfToken())
    {
        if ($request->getHeader(WebSession::CSRF_HEADER_NAME) !== null)
        {
            WebSession::respondJson(['error' => 'csrf_failed'], ResponseCode::FORBIDDEN);
        }

        WebSession::redirectTo(WebSession::flash('error', 'csrf_failed')
            ? $request->getPath()
            : $request->getPath() . '?' . http_build_query(['error' => 'csrf_failed']));
    }

    // The login page redirects authenticated sessions to the dashboard. The error
    // page is deliberately exempt so it remains visible when that dashboard route
    // cannot reach the configured server.
    switch(WebSession::getCurrentRoute()->getId())
    {
        case 'authenticate':
            if($cookieSession->get('authenticated', false) && !ViewAuthorization::isAnonymous())
            {
                WebSession::redirectToRoute('dashboard');
            }
            return;

        case 'configuration_error':
        case 'logout':
            return;

        default:
            /** @var ServerInformation|null $serverInformation */
            $serverInformation = WebSession::get('server_information');
            $routeId = WebSession::getCurrentRoute()->getId();

            if (ViewAuthorization::isAnonymous())
            {
                if ($serverInformation === null || !ViewAuthorization::canViewRoute($routeId, $serverInformation))
                {
                    WebSession::redirectToRoute('authenticate');
                }

                return;
            }

            if ($serverInformation !== null && !ViewAuthorization::canViewRoute($routeId, $serverInformation))
            {
                WebSession::redirectToRoute('dashboard');
            }

            // Set the API key on the FederationClient so authenticated requests work.
            $apiKey = $cookieSession->get('api_key');
            if ($apiKey !== null)
            {
                /** @var FederationClient $federationClient */
                $federationClient = WebSession::get('federation_client');
                if ($federationClient !== null)
                {
                    $federationClient->setAccessToken($apiKey);
                }
            }
            break;
    }

