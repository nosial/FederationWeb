<?php
    use DynamicalWeb\Html\Functions;
    use WebKernel\Utilities;
    use DynamicalWeb\WebSession;
    use WebKernel\EntityDetailView;

    /** @var EntityDetailView $view */
    $view = WebSession::get('entity_detail_view');

    if ($view->getEntity() === null)
    {
        return;
    }
?>
        <script>
        (function() {
            var existingMetadata = <?php echo json_encode($view->getEntity()->getMetadata() ?? [], JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT); ?>;

            var metadataContainer = document.getElementById('metadataRows');
            var metadataEmpty = document.getElementById('metadataEmpty');
            var metadataHidden = document.getElementById('entityMetadataHidden');
            var addBtn = document.getElementById('addMetadataBtn');
            var editForm = document.getElementById('editEntityForm');

            var typeOptions = [
                { value: 'string', label: '<?php Functions::printl('modal_edit_metadata_type_string'); ?>' },
                { value: 'boolean', label: '<?php Functions::printl('modal_edit_metadata_type_boolean'); ?>' },
                { value: 'integer', label: '<?php Functions::printl('modal_edit_metadata_type_integer'); ?>' },
                { value: 'null', label: '<?php Functions::printl('modal_edit_metadata_type_null'); ?>' }
            ];

            function renderValueWidget(type, value) {
                var container = document.createElement('div');
                container.style.flex = '1';
                container.style.minWidth = '120px';
                switch (type) {
                    case 'string':
                        var input = document.createElement('input');
                        input.type = 'text';
                        input.className = 'fw-form-control';
                        input.placeholder = '<?php Functions::printl('modal_edit_metadata_value_placeholder'); ?>';
                        input.setAttribute('data-md-value', '');
                        input.value = value !== null && value !== undefined ? String(value) : '';
                        container.appendChild(input);
                        break;
                    case 'boolean':
                        var select = document.createElement('select');
                        select.className = 'fw-form-control';
                        select.setAttribute('data-md-value', '');
                        var optTrue = document.createElement('option');
                        optTrue.value = 'true';
                        optTrue.textContent = '<?php Functions::printl('true_label'); ?>';
                        var optFalse = document.createElement('option');
                        optFalse.value = 'false';
                        optFalse.textContent = '<?php Functions::printl('false_label'); ?>';
                        select.appendChild(optTrue);
                        select.appendChild(optFalse);
                        select.value = value === true || value === 'true' ? 'true' : 'false';
                        container.appendChild(select);
                        break;
                    case 'integer':
                        var input = document.createElement('input');
                        input.type = 'number';
                        input.className = 'fw-form-control';
                        input.placeholder = '0';
                        input.step = '1';
                        input.setAttribute('data-md-value', '');
                        input.value = value !== null && value !== undefined ? Number(value) : 0;
                        container.appendChild(input);
                        break;
                    case 'null':
                        var span = document.createElement('span');
                        span.className = 'fw-form-text text-muted';
                        span.style.padding = '0.375rem 0';
                        span.style.display = 'inline-block';
                        span.textContent = '<?php Functions::printl('null_label'); ?>';
                        container.appendChild(span);
                        break;
                }
                return container;
            }

            function createRow(key, value) {
                var detectedType = 'string';
                if (value === null || value === undefined) {
                    detectedType = 'null';
                } else if (typeof value === 'boolean') {
                    detectedType = 'boolean';
                } else if (typeof value === 'number' && Number.isInteger(value)) {
                    detectedType = 'integer';
                }

                var row = document.createElement('div');
                row.className = 'fw-metadata-row d-flex gap-2 align-items-center mb-2';

                var keyInput = document.createElement('input');
                keyInput.type = 'text';
                keyInput.className = 'fw-form-control';
                keyInput.placeholder = '<?php Functions::printl('modal_edit_metadata_key_placeholder'); ?>';
                keyInput.style.minWidth = '160px';
                keyInput.style.width = 'auto';
                keyInput.style.flex = '0 1 180px';
                keyInput.setAttribute('data-md-key', '');
                keyInput.value = key || '';

                var typeSelect = document.createElement('select');
                typeSelect.className = 'fw-form-control';
                typeSelect.style.minWidth = '100px';
                typeSelect.style.width = 'auto';
                typeSelect.style.flex = '0 1 120px';
                typeSelect.setAttribute('data-md-type', '');
                typeOptions.forEach(function(opt) {
                    var option = document.createElement('option');
                    option.value = opt.value;
                    option.textContent = opt.label;
                    typeSelect.appendChild(option);
                });
                typeSelect.value = detectedType;

                var valueWidget = renderValueWidget(detectedType, value);

                var removeBtn = document.createElement('button');
                removeBtn.type = 'button';
                removeBtn.className = 'fw-btn fw-btn-ghost fw-btn-sm fw-btn-icon';
                removeBtn.setAttribute('data-md-remove', '');
                removeBtn.title = '<?php Functions::printl('remove'); ?>';
                removeBtn.innerHTML = '<i class="bi bi-x-circle"></i>';
                removeBtn.addEventListener('click', function() {
                    row.remove();
                    updateEmptyState();
                });

                typeSelect.addEventListener('change', function() {
                    var newType = typeSelect.value;
                    var oldValue = getRowValue(row);
                    var newWidget = renderValueWidget(newType, oldValue);
                    valueWidget.replaceWith(newWidget);
                    valueWidget = newWidget;
                });

                row.appendChild(keyInput);
                row.appendChild(typeSelect);
                row.appendChild(valueWidget);
                row.appendChild(removeBtn);
                return row;
            }

            function getRowValue(row) {
                var typeSelect = row.querySelector('[data-md-type]');
                var type = typeSelect ? typeSelect.value : 'string';
                var valueEl = row.querySelector('[data-md-value]');
                switch (type) {
                    case 'string':
                        return valueEl ? valueEl.value : '';
                    case 'boolean':
                        return valueEl ? valueEl.value === 'true' : false;
                    case 'integer':
                        return valueEl ? parseInt(valueEl.value, 10) || 0 : 0;
                    case 'null':
                        return null;
                }
                return null;
            }

            function getRowKey(row) {
                var el = row.querySelector('[data-md-key]');
                return el ? el.value.trim() : '';
            }

            function buildMetadataObject() {
                var rows = metadataContainer.querySelectorAll('.fw-metadata-row');
                var obj = {};
                rows.forEach(function(row) {
                    var key = getRowKey(row);
                    if (key === '') return;
                    obj[key] = getRowValue(row);
                });
                return obj;
            }

            function updateEmptyState() {
                var rows = metadataContainer.querySelectorAll('.fw-metadata-row');
                if (metadataEmpty) {
                    metadataEmpty.style.display = rows.length === 0 ? 'block' : 'none';
                }
            }

            function addRow(key, value) {
                var row = createRow(key, value);
                if (metadataEmpty) {
                    metadataContainer.insertBefore(row, metadataEmpty);
                } else {
                    metadataContainer.appendChild(row);
                }
                updateEmptyState();
            }

            if (editForm) {
                editForm.addEventListener('submit', function() {
                    var obj = buildMetadataObject();
                    var keys = Object.keys(obj);
                    metadataHidden.value = keys.length > 0 ? JSON.stringify(obj) : '{}';
                });
            }

            if (addBtn) {
                addBtn.addEventListener('click', function() {
                    addRow('', '');
                });
            }

            var metaKeys = Object.keys(existingMetadata);
            if (metaKeys.length > 0) {
                metaKeys.forEach(function(key) {
                    addRow(key, existingMetadata[key]);
                });
            } else {
                updateEmptyState();
            }
        })();

        (function() {
            var input = document.getElementById('relationshipTarget');
            var results = document.getElementById('relationshipTargetResults');
            if (!input || !results) return;

            var currentUuid = '<?php Functions::print($view->getEntity()->getUuid()); ?>';
            var searchRoute = '<?php Functions::printRoute('search'); ?>';
            var timer = null;
            var selectedIndex = -1;

            function escapeHtml(str) {
                var div = document.createElement('div');
                div.textContent = str;
                return div.innerHTML;
            }

            function closeDropdown() {
                results.classList.remove('open');
                results.innerHTML = '';
                selectedIndex = -1;
            }

            function selectItem(item) {
                input.value = item.value || item.title;
                closeDropdown();
                input.focus();
            }

            function renderDropdown(items) {
                results.innerHTML = '';
                if (items.length === 0) {
                    results.innerHTML = '<div class="fw-autocomplete-empty"><?php Functions::print(Utilities::localize('no_entities')); ?></div>';
                    results.classList.add('open');
                    return;
                }

                items.forEach(function(item, i) {
                    var div = document.createElement('div');
                    div.className = 'fw-autocomplete-item';
                    div.setAttribute('data-index', i);
                    div.innerHTML = '<div class="fw-autocomplete-item-title">' + escapeHtml(item.title) + '</div>' +
                        '<div class="fw-autocomplete-item-desc fw-uuid">' + escapeHtml(item.value) + '</div>';

                    div.addEventListener('mousedown', function(e) {
                        e.preventDefault();
                        selectItem(item);
                    });
                    div.addEventListener('mouseenter', function() {
                        results.querySelectorAll('.fw-autocomplete-item').forEach(function(el) { el.classList.remove('active'); });
                        div.classList.add('active');
                        selectedIndex = i;
                    });

                    results.appendChild(div);
                });

                results.classList.add('open');
                selectedIndex = -1;
            }

            function doSearch(query) {
                if (query.length < 2) { closeDropdown(); return; }

                var xhr = new XMLHttpRequest();
                xhr.open('POST', searchRoute, true);
                xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
                xhr.onload = function() {
                    if (xhr.status === 200) {
                        try {
                            var resp = JSON.parse(xhr.responseText);
                            var items = (resp.results || []).filter(function(item) {
                                return item.type === 'ENTITY' && item.value && item.value !== currentUuid;
                            });
                            renderDropdown(items);
                        } catch(e) { closeDropdown(); }
                    } else { closeDropdown(); }
                };
                xhr.onerror = function() { closeDropdown(); };
                xhr.send('action=search_dropdown&q=' + encodeURIComponent(query));
            }

            function updateActive(items) {
                items.forEach(function(el, i) {
                    el.classList.toggle('active', i === selectedIndex);
                });
            }

            input.addEventListener('input', function() {
                clearTimeout(timer);
                var val = this.value.trim();
                if (val.length >= 2) {
                    timer = setTimeout(function() { doSearch(val); }, 250);
                } else {
                    closeDropdown();
                }
            });

            input.addEventListener('keydown', function(e) {
                var items = results.querySelectorAll('.fw-autocomplete-item');

                if (e.key === 'Enter') {
                    var active = results.querySelector('.fw-autocomplete-item.active');
                    if (active) {
                        e.preventDefault();
                        var idx = parseInt(active.getAttribute('data-index'), 10);
                        var stored = results.querySelectorAll('.fw-autocomplete-item');
                        var item = stored[idx];
                        if (item) item.click();
                    }
                } else if (e.key === 'ArrowDown') {
                    e.preventDefault();
                    if (items.length === 0) return;
                    selectedIndex = Math.min(selectedIndex + 1, items.length - 1);
                    updateActive(items);
                } else if (e.key === 'ArrowUp') {
                    e.preventDefault();
                    if (items.length === 0) return;
                    selectedIndex = Math.max(selectedIndex - 1, 0);
                    updateActive(items);
                } else if (e.key === 'Escape') {
                    closeDropdown();
                }
            });

            input.addEventListener('blur', function() {
                setTimeout(closeDropdown, 150);
            });
        })();

        (function() {
            var modal = document.getElementById('modalBlacklistEntity');
            var reportInput = document.getElementById('blacklistReportUuid');
            if (!modal || !reportInput) return;

            modal.addEventListener('show.bs.modal', function(event) {
                var trigger = event.relatedTarget;
                if (trigger && trigger.dataset.reportUuid) {
                    reportInput.value = trigger.dataset.reportUuid;
                }
            });
        })();

        (function() {
            var viewAll = document.getElementById('entityRelatedViewAll');
            var tabs = document.getElementById('entityRelatedTabs');
            if (!viewAll || !tabs) return;
            var links = {
                tabEntityReports: '<?php Functions::printRoute('reports', queryParams: ['entity_id' => $view->getEntity()->getUuid()]); ?>',
                tabEntityEvidence: '<?php Functions::printRoute('evidence', queryParams: ['entity_id' => $view->getEntity()->getUuid()]); ?>',
                tabEntityBlacklist: '<?php Functions::printRoute('blacklist', queryParams: ['entity_id' => $view->getEntity()->getUuid()]); ?>',
                tabEntityAuditLog: '<?php Functions::printRoute('audit_log', queryParams: ['entity_id' => $view->getEntity()->getUuid()]); ?>'
            };
            tabs.querySelectorAll('[data-bs-toggle="tab"]').forEach(function(button) {
                button.addEventListener('shown.bs.tab', function() {
                    viewAll.href = links[this.getAttribute('data-bs-target').slice(1)];
                });
            });
        })();
        </script>
