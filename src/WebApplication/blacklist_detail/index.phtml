<?php
    use DynamicalWeb\Enums\RequestMethod;
    use DynamicalWeb\Html\Functions;
    use WebKernel\Utilities;
    use DynamicalWeb\WebSession;
    use WebKernel\BlacklistDetailView;
    use WebKernel\ViewAuthorization;

    Functions::loadLocalization('blacklist');

    $view = new BlacklistDetailView();
    WebSession::set('blacklist_detail_view', $view);

    if (WebSession::getRequest()->getMethod() === RequestMethod::POST && $view->getRecord() !== null)
    {
        $view->handlePostRequest();
    }
?>
<!DOCTYPE html>
<html lang="<?php Functions::print(WebSession::getLocale()?->getLocaleCode() ?? 'en'); ?>" data-fw-theme="<?php Functions::print($view->isDarkMode() ? 'dark' : ''); ?>">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <?php Functions::insertSection('../sections/head.phtml'); ?>
        <title><?php Functions::printl('record_title'); ?> — <?php Functions::print($view->getRecord() !== null ? substr($view->getRecord()->getUuid(), 0, 8) . '…' : Utilities::localize('error_label')); ?></title>
        <link rel="stylesheet" href="/vendor/bootstrap-icons/bootstrap-icons.min.css">
        <link rel="stylesheet" href="/css/federation.css">
    </head>
    <body class="fw-page--blacklist">
        <div class="fw-wrapper">
            <?php Functions::insertSection('../sections/fw_topbar.phtml'); ?>
            <?php Functions::insertSection('../sections/fw_topnav.phtml'); ?>
            <div class="fw-main">
                <div class="fw-content">
                    <?php
                        if ($view->hasError() || $view->getRecord() === null)
                        {
                            ?>
                            <div class="fw-error">
                                <div class="fw-error-card">
                                    <div class="fw-error-icon fw-error-icon-red">
                                        <i class="bi bi-exclamation-circle"></i>
                                    </div>
                                    <p class="fw-error-description"><?php Functions::printl('error_loading_entry'); ?></p>
                                    <div class="fw-error-actions">
                                        <a href="<?php Functions::printRoute('blacklist'); ?>" class="fw-btn fw-btn-primary">
                                            <i class="bi bi-arrow-left"></i> <?php Functions::printl('back'); ?>
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <?php
                        }
                        else
                        {
                            if ($view->getSuccessMessage())
                            {
                                ?>
                                <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-check-circle-fill"></i>
                                        <span><?php Functions::printl($view->getSuccessMessage()); ?></span>
                                    </div>
                                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                                </div>
                                <?php
                            }

                            if ($view->getErrorMessage())
                            {
                                ?>
                                <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-exclamation-triangle-fill"></i>
                                        <div>
                                            <strong><?php Functions::printl($view->getErrorMessage()); ?></strong>
                                            <?php
                                                if ($view->getErrorDetail())
                                                {
                                                    ?><br><span class="fw-error-detail"><?php Functions::print($view->getErrorDetail()); ?></span><?php
                                                }
                                            ?>
                                        </div>
                                    </div>
                                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                                </div>
                                <?php
                            }
                            ?>
                            <?php
                            Functions::insertSection('detail.phtml');
                            Functions::insertSection('related.phtml');
                            Functions::insertSection('modals.phtml');
                        }
                    ?>
                </div>
            </div>
        </div>
        <script src="/vendor/bootstrap/bootstrap.bundle.min.js"></script>
        <script src="/js/app.js"></script>
        <script src="/js/nav.js"></script>
